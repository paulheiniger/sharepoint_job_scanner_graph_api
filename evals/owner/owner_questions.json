{
  "suite_id": "spraytec_owner_questions_v1",
  "description": "Synthetic owner-level questions used to evaluate evidence selection, source discipline, and confidence labeling without requiring production ground truth.",
  "truth_classes": [
    "authoritative",
    "inferred",
    "proxy"
  ],
  "cases": [
    {
      "case_id": "owner_attention_today",
      "question": "What needs my attention today across sales, production, scheduling, and office work?",
      "category": "executive_briefing",
      "capability_status": "partial",
      "required_operations": [
        "getSalesFollowUps",
        "getOperationsBacklog",
        "getOperationsSchedule",
        "getProductionBudgetHealth",
        "getOfficeJobProgress"
      ],
      "synthetic_evidence": [
        {"fact_id": "overdue_followups", "value": 6, "truth_class": "authoritative", "source_operation": "getSalesFollowUps", "source_table": "dashboard_sales_followup"},
        {"fact_id": "missing_job_specs", "value": 2, "truth_class": "authoritative", "source_operation": "getOperationsBacklog", "source_table": "operations_dashboard_ops_snapshot"},
        {"fact_id": "unassigned_scheduled_jobs", "value": 1, "truth_class": "authoritative", "source_operation": "getOperationsSchedule", "source_table": "operations_dashboard_ops_snapshot"},
        {"fact_id": "jobs_over_production_plan", "value": 2, "truth_class": "proxy", "source_operation": "getProductionBudgetHealth", "source_table": "job_tracking_estimate_budget_snapshot"},
        {"fact_id": "office_projects_without_confident_job_link", "value": 14, "truth_class": "inferred", "source_operation": "getOfficeJobProgress", "source_table": "office_timesheet_entries"}
      ],
      "expected": {
        "must_report_fact_ids": ["overdue_followups", "missing_job_specs", "unassigned_scheduled_jobs", "jobs_over_production_plan"],
        "must_include_truth_labels": ["proxy", "inferred"],
        "required_qualifications": ["Production cost is estimate-rate usage, not accounting actual cost.", "Office-to-job links are inferred unless a direct job ID is present."],
        "must_not_claim": ["accounting profit", "authoritative office job assignment"]
      }
    },
